<Project Sdk="Microsoft.NET.Sdk">
  <!-- 명세(DSL)와 생성기. 앱(C#)이 빌드할 때 이걸 실행해 obj/dsl/ 에 C# · JS 를 만든다 — build/Dsl.targets -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Model.fs" />
    <Compile Include="Spec.fs" />
    <Compile Include="Emit.fs" />
    <Compile Include="GenContracts.fs" />
    <Compile Include="GenAvalonia.fs" />
    <Compile Include="GenAndroid.fs" />
    <Compile Include="GenWeb.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
