<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows 앱 — Avalonia 12 + 공식 WebView. 상단 바 부품 · 계약은 dsl 이 생성한다(build/Dsl.targets)
         NativeAOT(실험) — 맥 · Linux 에서도 교차 빌드하려고 AotAnywhere(맥에서만 확인)
         dotnet publish src/Windows -r win-x64 -c Release     (-r win-arm64 도 같다) -->
  <Sdk Name="StuDev.AotAnywhere" Version="1.1.0" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FSharpDslDrivenCrossPlatform</AssemblyName>
    <RootNamespace>App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishAot>true</PublishAot>
    <!-- WebView2 COM 선언(WebView2Com.cs)은 COM 소스 생성기로 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DslTargets>contracts avalonia</DslTargets>
  </PropertyGroup>
  <Import Project="../../build/Dsl.targets" />
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>
  <!-- 런처 페이지(web/) + 생성된 다리(obj/dsl/web) → 실행 파일 옆 web/ -->
  <ItemGroup>
    <Content Include="../../web/**" LinkBase="web" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="DslWebContent" AfterTargets="DslGenerate">
    <ItemGroup>
      <DslWeb Include="$(DslOut)web/*.js" />
      <Content Include="@(DslWeb)" Link="web/%(DslWeb.Filename)%(DslWeb.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
